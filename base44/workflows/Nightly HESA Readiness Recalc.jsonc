{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "nightly_hesa_recalc",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "recalc_all": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "NightlyHesaRecalc"
          },
          "then": "end",
          "x-base44": {
            "title": "Recalculate all HESA readiness",
            "description": "Nightly safety net"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 2 * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Nightly HESA Readiness Recalc",
  "description": "Safety-net nightly recalculation of HESA readiness across all engagement records. Catches anything the event-trigger workflows missed (bulk imports/migrations). Never manual. See base44/shared/studentStatus.ts."
}