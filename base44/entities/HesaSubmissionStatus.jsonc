{
  "name": "HesaSubmissionStatus",
  "description": "Per-student HESA submission memory: tracks whether the student was included in a previous accepted return, what changed since that submission, and the current state. Updates automatically as the student's record changes \u2014 never depends on a user remembering to check/uncheck anything.",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string"
    },
    "academic_year": {
      "type": "string",
      "description": "e.g. 2025/26"
    },
    "included_in_accepted_return": {
      "type": "boolean",
      "description": "Whether the student was included in a previously accepted HESA return"
    },
    "last_submitted_date": {
      "format": "date",
      "type": "string"
    },
    "changed_since_submission": {
      "type": "boolean",
      "description": "Whether a HESA-relevant field has changed since the last accepted submission"
    },
    "change_summary": {
      "type": "string",
      "description": "What changed since the last accepted submission"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_submitted",
        "submitted",
        "changed_since",
        "resubmission_required"
      ]
    },
    "institution_id": {
      "type": "string"
    }
  },
  "required": [
    "student_id",
    "academic_year",
    "status",
    "institution_id"
  ],
  "rls": {
    "read": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "create": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "update": {
      "$and": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "registry"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}