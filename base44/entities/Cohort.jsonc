{
  "name": "Cohort",
  "properties": {
    "name": {
      "type": "string"
    },
    "course_id": {
      "type": "string"
    },
    "start_date": {
      "format": "date",
      "type": "string"
    },
    "end_date": {
      "format": "date",
      "type": "string"
    },
    "institution_id": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "course_id",
    "start_date",
    "institution_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "academic"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "update": {
      "$and": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "academic"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    }
  },
  "type": "object"
}