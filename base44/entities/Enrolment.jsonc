{
  "properties": {
    "end_date": {
      "description": "Set if student withdraws from this unit before term ends",
      "format": "date",
      "type": "string"
    },
    "start_date": {
      "description": "Actual date student joined this unit - handles late joiners so they are not marked absent for sessions before they enrolled",
      "format": "date",
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "withdrawn",
        "completed"
      ],
      "type": "string"
    },
    "student_id": {
      "description": "Reference to Student.id",
      "type": "string"
    },
    "unit_id": {
      "description": "Reference to Unit.id",
      "type": "string"
    }
  },
  "required": [
    "student_id",
    "unit_id",
    "start_date",
    "status"
  ],
  "type": "object",
  "name": "Enrolment"
}