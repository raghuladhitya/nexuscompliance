{
  "name": "AttendanceRecord",
  "properties": {
    "enrolment_id": {
      "type": "string"
    },
    "institution_id": {
      "type": "string"
    },
    "session_date": {
      "format": "date",
      "type": "string"
    },
    "status": {
      "enum": [
        "present",
        "absent",
        "authorised_absence"
      ],
      "type": "string"
    },
    "unit_id": {
      "type": "string"
    }
  },
  "required": [
    "enrolment_id",
    "unit_id",
    "session_date",
    "status",
    "institution_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "user_condition": {
            "role": "academic"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "update": {
      "$and": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "user_condition": {
            "role": "academic"
          }
        }
      ]
    }
  },
  "type": "object"
}