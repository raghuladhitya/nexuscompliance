{
  "name": "SessionStatus",
  "description": "A point-in-time session status for an Engagement, tracking status valid-from/changed-to over time. Multiple records form a history; the latest by valid_from is the current status. This replaces a single status field \u2014 status is a timeline, not a value.",
  "type": "object",
  "properties": {
    "engagement_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "break_in_study",
        "resumed",
        "withdrawn",
        "transferred"
      ],
      "description": "Raw HESA session status (backend-facing); users see the derived plain label"
    },
    "valid_from": {
      "format": "date",
      "type": "string",
      "description": "Date this status became valid"
    },
    "reason": {
      "type": "string"
    },
    "institution_id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "hesa_xml",
        "ebs_export",
        "reconciliation",
        "system"
      ]
    },
    "source_year": {
      "type": "string"
    },
    "reconciliation_status": {
      "type": "string",
      "enum": [
        "pending",
        "clean",
        "duplicate_flagged"
      ]
    }
  },
  "required": [
    "engagement_id",
    "status",
    "valid_from",
    "institution_id"
  ],
  "rls": {
    "read": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "create": {
      "$and": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "registry"
              }
            },
            {
              "user_condition": {
                "role": "academic"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "registry"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}