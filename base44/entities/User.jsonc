{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user",
        "admissions",
        "academic",
        "registry",
        "finance",
        "compliance",
        "management"
      ]
    },
    "institution_id": {
      "type": "string",
      "description": "Tenant scope for the user \u2014 must match the institution_id on records they own (used by RLS)"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object",
  "rls": {
    "read": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "update": {
      "$and": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}