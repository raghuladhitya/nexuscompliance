{
  "description": "One record per real person, independent of how many times they enrol, transfer, or reattempt. First created at the Admissions stage.",
  "name": "Student",
  "properties": {
    "person_code": {
      "description": "Unique person identifier within the institution",
      "type": "string"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "date_of_birth": {
      "format": "date",
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "course_applied": {
      "description": "Course the student applied for, captured at admission",
      "type": "string"
    },
    "intake": {
      "description": "Intake / cohort the student is entering, e.g. Sep 2026",
      "type": "string"
    },
    "institution_id": {
      "description": "Tenant scope",
      "type": "string"
    },
    "possible_duplicate_of": {
      "description": "Student id this record may be a duplicate of, if flagged by the system",
      "type": "string"
    }
  },
  "required": [
    "person_code",
    "first_name",
    "last_name",
    "institution_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admissions"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "update": {
      "data.institution_id": "{{user.data.institution_id}}"
    }
  },
  "type": "object"
}