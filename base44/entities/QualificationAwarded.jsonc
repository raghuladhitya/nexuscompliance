{
  "name": "QualificationAwarded",
  "description": "An actual award made to a student, linked to a Qualification (full or intermediate) and an Engagement. The presence of a QualificationAwarded resolves a Leaver's outcome; its absence forces the computed status to 'Outcome Pending' and HesaSubmissionState to needs_review.",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string"
    },
    "engagement_id": {
      "type": "string"
    },
    "qualification_id": {
      "type": "string"
    },
    "award_date": {
      "format": "date",
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "description": "e.g. classification (First, 2:1, Pass)"
    },
    "institution_id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "hesa_xml",
        "ebs_export",
        "reconciliation",
        "system"
      ]
    },
    "source_year": {
      "type": "string"
    },
    "reconciliation_status": {
      "type": "string",
      "enum": [
        "pending",
        "clean",
        "duplicate_flagged"
      ]
    }
  },
  "required": [
    "student_id",
    "engagement_id",
    "qualification_id",
    "institution_id"
  ],
  "rls": {
    "read": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "create": {
      "$and": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "registry"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "registry"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}