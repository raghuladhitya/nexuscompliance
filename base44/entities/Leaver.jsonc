{
  "name": "Leaver",
  "description": "Created whenever a student's engagement ends for any reason. Holds the engagement end date, intended destination and reason for ending. A Leaver record with NO linked QualificationAwarded forces the computed status to 'Outcome Pending' and the related HesaSubmissionState to needs_review \u2014 this state must never silently resolve to 'ready' until Registry links an actual outcome.",
  "type": "object",
  "properties": {
    "engagement_id": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "end_date": {
      "format": "date",
      "type": "string"
    },
    "intended_destination": {
      "type": "string"
    },
    "reason_for_ending": {
      "type": "string"
    },
    "institution_id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "hesa_xml",
        "ebs_export",
        "reconciliation",
        "system"
      ]
    },
    "source_year": {
      "type": "string"
    },
    "reconciliation_status": {
      "type": "string",
      "enum": [
        "pending",
        "clean",
        "duplicate_flagged"
      ]
    }
  },
  "required": [
    "engagement_id",
    "student_id",
    "end_date",
    "institution_id"
  ],
  "rls": {
    "read": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "create": {
      "$and": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "registry"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "registry"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}