{
  "name": "Engagement",
  "description": "The true anchor linking a Student to their study activity. Replaces the dual role Enrolment played. A Student has one Engagement per study instance; SessionStatus, Leaver and QualificationAwarded hang off this anchor. The plain-language status shown to users is NEVER stored here \u2014 it is always derived by the translation layer from Engagement + SessionStatus + Leaver + QualificationAwarded.",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string"
    },
    "course_id": {
      "type": "string"
    },
    "course_session_id": {
      "type": "string",
      "description": "Link to StudentCourseSession"
    },
    "start_date": {
      "format": "date",
      "type": "string"
    },
    "end_date": {
      "format": "date",
      "type": "string",
      "description": "Engagement end date (set when the student leaves)"
    },
    "institution_id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "hesa_xml",
        "ebs_export",
        "reconciliation",
        "system"
      ],
      "description": "Migration source this record was ingested from"
    },
    "source_year": {
      "type": "string",
      "description": "Historical HESA XML year, e.g. 2024/25"
    },
    "reconciliation_status": {
      "type": "string",
      "enum": [
        "pending",
        "clean",
        "duplicate_flagged"
      ],
      "description": "Identity/duplication reconciliation state across ingestion sources"
    }
  },
  "required": [
    "student_id",
    "course_id",
    "start_date",
    "institution_id"
  ],
  "rls": {
    "read": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "create": {
      "$and": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "registry"
              }
            },
            {
              "user_condition": {
                "role": "admissions"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "registry"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}