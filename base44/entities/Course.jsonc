{
  "name": "Course",
  "properties": {
    "code": {
      "type": "string"
    },
    "institution_id": {
      "type": "string"
    },
    "level": {
      "enum": [
        "undergraduate",
        "postgraduate",
        "further_education",
        "apprenticeship"
      ],
      "type": "string"
    },
    "name": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "code",
    "institution_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "user_condition": {
            "role": "academic"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "data.institution_id": "{{user.data.institution_id}}"
    },
    "update": {
      "$and": [
        {
          "data.institution_id": "{{user.data.institution_id}}"
        },
        {
          "user_condition": {
            "role": "academic"
          }
        }
      ]
    }
  },
  "type": "object"
}